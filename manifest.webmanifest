    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Nueva foto", "url": "./index.html#/fotos?nueva=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Muro", "url": "./index.html#/muro", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Clima", "url": "./index.html#/clima", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Fichar", "url": "./index.html#/partes", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
